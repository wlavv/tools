{
    "summary": {
        "module_name": "ModuleCompliance",
        "display_name": "Module Compliance Center",
        "objetivo": "Estabelecer uma camada central de controlo de qualidade no WebTools Manager \/ B.O. Custom LSG, orquestrando validações automáticas (estrutural, visual, técnica e de integração) sobre módulos LSG gerados, desenvolvidos ou importados, assegurando que cumprem os standards do ecossistema antes de serem promovidos para produção.",
        "abrangencia": {
            "descricao": "O módulo atua como orquestrador central de validações, gerindo normas, tópicos de validação, execuções (runs), scoring, relatórios finais e comunicação com sistemas nucleares (IdeaLab, AI Consensus, Module Health, Project Manager). Integra-se com validadores especializados e visa automatizar o fluxo de aceitação de novos módulos.",
            "principais_funcionalidades": [
                "Gestão de standards de conformidade.",
                "Gestão granular de tópicos de validação e severidade.",
                "Execução de runs de validação, via UI ou API.",
                "Integração via gateway com validadores interna e externamente.",
                "Cálculo automático de scores e status finais.",
                "Geração de relatórios detalhados e sumarizados.",
                "Integração direta com AI Consensus para sugestões\/parecer técnico.",
                "Criação automática de tarefas no Project Manager.",
                "UI com dashboard, histórico, standards, tópicos, relatórios e navegação eficiente."
            ]
        }
    },
