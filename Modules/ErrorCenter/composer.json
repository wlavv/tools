{
    "name": "implementacao-pendente/error-center",
    "description": "Laravel Error Center / Exception Viewer module for capturing, grouping, viewing and notifying runtime errors.",
    "type": "laravel-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "illuminate/support": ">=10.0",
        "illuminate/database": ">=10.0",
        "illuminate/routing": ">=10.0",
        "illuminate/view": ">=10.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\ErrorCenter\\": "",
            "Modules\\ErrorCenter\\Database\\Seeders\\": "Database/Seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\ErrorCenter\\Providers\\ErrorCenterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
